{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "writemate.top" }],
      "destination": "https://cn.writemate.top/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.writemate.top" }],
      "destination": "https://cn.writemate.top/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ]
}
